# Neon 대시보드 -> Connection string에서 복사
# 반드시 ?sslmode=require 가 붙어있는지 확인하세요
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# 글쓰기 페이지(/write.html) 및 글 작성/수정/삭제 API를 보호하는 관리자 계정
# 원하는 아이디/비밀번호로 바꿔서 사용하세요
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
